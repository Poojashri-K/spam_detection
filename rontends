:root {
  font-family: Inter, "Segoe UI", sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #1e2b3d;
  background: #f4f7fb;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  --bg-body: #f4f7fb;
  --bg-panel: rgba(255, 255, 255, 0.82);
  --stroke: #e5eaf2;
  --stroke-strong: #dfe5ee;
  --text: #1e2b3d;
  --text-muted: #66758d;
  --text-faint: #8b98ad;
  --primary: #4969cd;
  --primary-dark: #3a58b7;
  --shadow: 0 20px 48px rgba(24, 38, 67, 0.09);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  min-width: 320px;
  min-height: 100vh;
  margin: 0;
  background: radial-gradient(circle at top, rgba(126, 144, 255, 0.18), transparent 28rem), var(--bg-body);
  color: var(--text);
}
button, textarea { font-family: inherit; }
#root { min-height: 100vh; }

.page-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 32px 24px;
}

.app-container {
  width: min(100%, 1180px);
  min-height: min(900px, calc(100vh - 56px));
  display: flex;
  flex-direction: column;
  padding: 0 32px;
  border: 1px solid var(--stroke);
  border-radius: 24px;
  background: var(--bg-panel);
  backdrop-filter: blur(8px);
  box-shadow: var(--shadow);
}

.app-shell { display: flex; flex-direction: column; min-height: 100%; }
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 88px;
  border-bottom: 1px solid var(--stroke);
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: -0.3px;
  text-decoration: none;
}

.brand-mark {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: linear-gradient(135deg, #edf3ff 0%, #f5f1ff 100%);
  color: var(--primary);
}

.brand-mark svg {
  width: 20px;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.navbar {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.nav-link {
  position: relative;
  padding: 9px 12px;
  border-radius: 10px;
  color: var(--text-muted);
  font-size: 0.78rem;
  font-weight: 650;
  letter-spacing: 0.04em;
  text-decoration: none;
  transition: color 180ms ease, background 180ms ease, transform 180ms ease;
}

.nav-link:hover { background: rgba(73, 105, 205, 0.06); color: var(--text); }
.nav-link.active {
  background: rgba(73, 105, 205, 0.1);
  color: var(--primary);
}
.nav-link.active::after {
  content: "";
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 6px;
  height: 2px;
  border-radius: 999px;
  background: var(--primary);
}

.theme-toggle {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border: 1px solid var(--stroke);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.7);
  color: var(--text);
  cursor: pointer;
  transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
}
.theme-toggle:hover {
  transform: translateY(-1px);
  border-color: rgba(73, 105, 205, 0.2);
  background: rgba(73, 105, 205, 0.05);
}

.page-body { flex: 1; padding: 32px 0 0; }
.page-section {
  width: min(100%, 960px);
  margin: 0 auto;
  padding-bottom: 32px;
  animation: fadeUp 480ms ease;
}

.hero-section {
  width: min(100%, 820px);
  margin: 24px auto 24px;
  text-align: center;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--primary);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--primary);
  box-shadow: 0 0 0 4px rgba(73, 105, 205, 0.1);
}

.hero-section h1,
.section-header h2,
.section-header h3 { margin: 18px 0 12px; color: var(--text); letter-spacing: -0.06em; }
.hero-section h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); line-height: 1.08; }
.intro {
  max-width: 640px;
  margin: 0 auto;
  color: var(--text-muted);
  font-size: 1.02rem;
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 30px;
}

.primary-button,
.secondary-button,
.analyze-button,
.clear-button,
.details-button,
.action-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 46px;
  padding: 0 20px;
  border-radius: 12px;
  font: inherit;
  font-size: 0.82rem;
  font-weight: 700;
  text-decoration: none;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
}

.primary-button {
  border: 0;
  background: linear-gradient(135deg, var(--primary) 0%, #5c7de3 100%);
  color: white;
  box-shadow: 0 16px 30px rgba(73, 105, 205, 0.25);
}
.primary-button:hover,
.secondary-button:hover,
.analyze-button:hover,
.action-link:hover { transform: translateY(-1px); }
.secondary-button {
  border: 1px solid var(--stroke);
  background: rgba(255, 255, 255, 0.55);
  color: var(--text);
}

.stats-grid,
.feature-grid,
.metric-grid,
.info-grid,
.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}
.stats-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); margin-top: 30px; }

.stat-card,
.feature-card,
.pipeline-step,
.metric-card,
.info-card,
.performance-card,
.summary-card,
.analysis-card,
.result-card,
.metrics-section,
.breakdown-card,
.definition-item,
.table-item {
  position: relative;
  overflow: hidden;
  border: 1px solid var(--stroke);
  border-radius: 18px;
  background: linear-gradient(180deg, rgba(255,255,255,0.9) 0%, rgba(247,249,252,0.9) 100%);
  box-shadow: 0 10px 24px rgba(30, 43, 61, 0.04);
}

.stat-card { padding: 22px 18px; text-align: left; }
.stat-card .value {
  display: block;
  margin-bottom: 8px;
  color: var(--text);
  font-size: clamp(1.3rem, 3vw, 2rem);
  font-weight: 800;
  letter-spacing: -0.06em;
}
.stat-card .label {
  color: var(--text-muted);
  font-size: 0.76rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.section-header { text-align: center; margin: 70px 0 24px; }
.section-header h2 { font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1.12; }
.section-header p {
  max-width: 620px;
  margin: 0 auto;
  color: var(--text-muted);
  line-height: 1.75;
}

.feature-card { padding: 24px 22px; text-align: left; }
.feature-card .icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  margin-bottom: 18px;
  background: linear-gradient(135deg, #edf4ff 0%, #f4f1ff 100%);
  color: var(--primary);
  font-size: 1.2rem;
}
.feature-card h3,
.info-card h3,
.metric-card h3,
.summary-card h3,
.performance-card h3 {
  margin: 0 0 8px;
  color: var(--text);
  font-size: 1.15rem;
}
.feature-card p,
.pipeline-step p,
.info-card p,
.metric-card p,
.performance-card p,
.summary-card p,
.definition-item p { margin: 0; color: var(--text-muted); line-height: 1.7; }

.why-block {
  margin-top: 42px;
  padding: 28px 26px;
  border: 1px solid var(--stroke);
  border-radius: 22px;
  background: linear-gradient(135deg, #eef4ff 0%, #f5f3ff 100%);
}
.why-block h3 { margin: 0 0 12px; font-size: 1.45rem; }

.pipeline-layout { display: flex; flex-direction: column; gap: 14px; margin-top: 32px; }
.pipeline-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
.pipeline-step { padding: 22px 20px; text-align: left; }
.pipeline-step .step-label {
  display: inline-block;
  margin-bottom: 12px;
  color: var(--primary);
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.pipeline-step h4 { margin: 0 0 8px; color: var(--text); font-size: 1.1rem; }
.pipeline-arrow {
  display: flex;
  justify-content: center;
  align-items: center;
  color: var(--primary);
  font-size: 1.5rem;
  margin: 3px 0;
}

.metric-card,
.performance-card,
.summary-card,
.info-card { padding: 22px 20px; }
.metric-card-header,
.summary-card-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
.model-tag {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(73, 105, 205, 0.1);
  color: var(--primary);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.model-tag.highlighted { background: linear-gradient(135deg, #eff4ff 0%, #f1f7ff 100%); color: var(--primary-dark); }
.metric-list { display: grid; gap: 12px; }
.metric-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 0;
  border-bottom: 1px solid rgba(229, 234, 242, 0.8);
}
.metric-row:last-child { border-bottom: none; }
.metric-name { color: var(--text-muted); font-size: 0.82rem; }
.metric-value { font-weight: 700; color: var(--text); }

.bar-wrapper { display: grid; gap: 10px; margin-top: 14px; }
.bar-row { display: grid; grid-template-columns: 100px 1fr 48px; align-items: center; gap: 10px; }
.bar-label { color: var(--text-muted); font-size: 0.72rem; }
.bar-track {
  position: relative;
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: #edf2f8;
  overflow: hidden;
}
.bar-fill {
  position: absolute;
  inset: 0 auto 0 0;
  border-radius: inherit;
  background: linear-gradient(90deg, #4e6bd9 0%, #5c7de3 100%);
}
.bar-fill.svm { background: linear-gradient(90deg, #2d9c7e 0%, #5ec5a2 100%); }
.bar-value { justify-self: end; color: var(--text); font-size: 0.72rem; font-weight: 700; }

.confusion-box {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
  padding: 14px;
  border: 1px solid var(--stroke);
  border-radius: 14px;
  background: #f8fafc;
}
.confusion-cell { padding: 16px 12px; border-radius: 10px; background: rgba(255,255,255,0.8); text-align: center; }
.confusion-cell strong { display: block; margin-top: 8px; color: var(--text); font-size: 1.5rem; }
.confusion-cell span { color: var(--text-muted); font-size: 0.78rem; }
.definition-list,
.table-list { display: grid; gap: 12px; margin-top: 18px; }
.definition-item,
.table-item { padding: 14px 16px; border: 1px solid var(--stroke); border-radius: 12px; background: rgba(255,255,255,0.6); }
.definition-item strong { display: block; margin-bottom: 6px; color: var(--text); }
.table-item { display: flex; justify-content: space-between; gap: 12px; }
.table-item span { color: var(--text-muted); }
.table-item strong { color: var(--text); }

.page-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 24px 0 30px;
  border-top: 1px solid var(--stroke);
  color: var(--text-faint);
  font-size: 0.76rem;
}
.footer-links { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
.footer-links a { color: var(--text-muted); text-decoration: none; }
.footer-links a:hover { color: var(--text); }

@keyframes fadeUp {
  0% { opacity: 0; transform: translateY(8px); }
  100% { opacity: 1; transform: translateY(0); }
}

.theme-dark {
  --bg-body: #0f172a;
  --bg-panel: rgba(15, 23, 42, 0.92);
  --stroke: rgba(148, 163, 184, 0.18);
  --stroke-strong: rgba(148, 163, 184, 0.22);
  --text: #e2e8f0;
  --text-muted: #cbd5e1;
  --text-faint: #94a3b8;
  --primary: #93c5fd;
  --primary-dark: #bfdbfe;
}
.theme-dark .brand-mark,
.theme-dark .model-tag,
.theme-dark .status-dot { background: rgba(147, 197, 253, 0.14); }
.theme-dark .nav-link.active,
.theme-dark .nav-link:hover,
.theme-dark .theme-toggle,
.theme-dark .secondary-button,
.theme-dark .clear-button,
.theme-dark .details-button,
.theme-dark .analysis-card,
.theme-dark .result-card,
.theme-dark .metrics-section,
.theme-dark .stat-card,
.theme-dark .feature-card,
.theme-dark .pipeline-step,
.theme-dark .metric-card,
.theme-dark .summary-card,
.theme-dark .info-card,
.theme-dark .definition-item,
.theme-dark .table-item,
.theme-dark .breakdown-card,
.theme-dark .confusion-cell,
.theme-dark .result-summary {
  background: rgba(15, 23, 42, 0.82);
  color: var(--text);
}
.theme-dark .analysis-card textarea { background: rgba(15, 23, 42, 0.72); color: var(--text); }
.theme-dark .primary-button,
.theme-dark .analyze-button { box-shadow: 0 16px 30px rgba(96, 165, 250, 0.2); }

.analysis-page { width: min(100%, 960px); }
.analysis-card {
  margin-top: 30px;
  padding: 26px;
  border: 1px solid var(--stroke);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18px 42px rgba(29, 48, 83, 0.06);
  text-align: left;
}
.card-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 17px;
}
.card-heading label {
  display: block;
  margin-bottom: 6px;
  color: var(--text);
  font-size: 0.9rem;
  font-weight: 650;
}
.card-heading p { color: var(--text-muted); font-size: 0.74rem; line-height: 1.5; }
.input-badge {
  flex: none;
  margin-top: 2px;
  padding: 6px 8px;
  border-radius: 6px;
  background: rgba(73, 105, 205, 0.06);
  color: var(--primary);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}
.analysis-card textarea {
  display: block;
  width: 100%;
  min-height: 180px;
  box-sizing: border-box;
  resize: vertical;
  padding: 16px;
  border: 1px solid var(--stroke-strong);
  border-radius: 10px;
  background: #fbfcfe;
  color: var(--text);
  font: inherit;
  font-size: 0.92rem;
  line-height: 1.7;
  transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
}
.analysis-card textarea::placeholder { color: #a1aaba; }
.analysis-card textarea:focus {
  border-color: rgba(73, 105, 205, 0.4);
  background: #fff;
  box-shadow: 0 0 0 3px rgba(73, 105, 205, 0.12);
  outline: none;
}
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 18px;
}
.character-count { color: var(--text-faint); font-size: 0.72rem; }
.action-buttons { display: flex; align-items: center; gap: 12px; }
.clear-button {
  min-height: 46px;
  border: 1px solid var(--stroke-strong);
  background: rgba(255,255,255,0.7);
  color: var(--text-muted);
  cursor: pointer;
}
.clear-button:hover:not(:disabled) {
  border-color: #ccd5e6;
  background: #f7f9fc;
}
.clear-button:disabled { cursor: wait; opacity: 0.6; }
.analyze-button {
  min-height: 46px;
  border: 0;
  background: linear-gradient(135deg, var(--primary) 0%, #5d7de7 100%);
  color: white;
  box-shadow: 0 14px 28px rgba(73, 105, 205, 0.2);
  cursor: pointer;
}
.analyze-button:disabled { cursor: wait; opacity: 0.8; }
.analyze-button svg {
  width: 16px;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.feedback-message {
  margin: 18px 0 0;
  padding: 12px 15px;
  border-radius: 10px;
  font-size: 0.8rem;
  text-align: left;
}
.error-message {
  border: 1px solid rgba(191, 79, 72, 0.12);
  background: rgba(191, 79, 72, 0.04);
  color: #bf4f48;
}
.loading-message { color: var(--primary); text-align: center; }

.result-card {
  margin-top: 18px;
  padding: 22px 24px;
  border: 1px solid var(--stroke);
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 12px 24px rgba(29, 48, 83, 0.04);
  text-align: left;
}
.result-card.prediction-spam { border-left: 4px solid #d95f58; }
.result-card.prediction-ham { border-left: 4px solid #3b9a68; }
.result-header { display: flex; align-items: center; justify-content: space-between; gap: 14px; }
.result-header h2 { margin: 5px 0 0; color: var(--text); font-size: 1.05rem; }
.result-kicker { color: var(--text-faint); font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
.severity-badge { padding: 7px 10px; border-radius: 999px; font-size: 0.7rem; font-weight: 700; text-align: center; }
.severity-low { background: #eaf7ef; color: #287345; }
.severity-medium { background: #fff4dd; color: #946314; }
.severity-high { background: #fff0ed; color: #a33b32; }
.result-summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
  margin-top: 18px;
  padding: 13px 14px;
  border-radius: 10px;
  background: #f7f9fc;
}
.result-label { color: var(--text-muted); font-size: 0.75rem; font-weight: 650; }
.prediction-value {
  padding: 6px 10px;
  border-radius: 7px;
  font-size: 0.75rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}
.prediction-value-spam { background: #fff0ed; color: #a33b32; }
.prediction-value-ham { background: #eaf7ef; color: #287345; }
.confidence-value { margin-left: auto; color: var(--text-muted); font-size: 0.73rem; font-weight: 600; }
.model-used { flex-basis: 100%; color: var(--text-faint); font-size: 0.68rem; }
.reason-list { margin-top: 18px; padding-top: 16px; border-top: 1px solid #edf0f5; }
.reason-list h3 {
  margin: 0 0 10px;
  color: var(--text);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.reason-list ul { margin: 0; padding-left: 18px; color: var(--text-muted); font-size: 0.8rem; line-height: 1.7; }
.no-reasons { margin: 0; color: var(--text-faint); font-size: 0.76rem; }
.privacy-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: 18px;
  color: var(--text-faint);
  font-size: 0.7rem;
}
.privacy-note svg { width: 14px; stroke: var(--text-faint); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }

.metrics-section {
  width: min(100%, 920px);
  margin: 0 auto 18px;
  padding: 22px;
  border: 1px solid var(--stroke);
  border-radius: 16px;
  background: rgba(255,255,255,0.9);
  box-shadow: 0 14px 28px rgba(29, 48, 83, 0.03);
  text-align: left;
}
.metrics-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
.metrics-heading h2 { margin: 6px 0 0; color: var(--text); font-size: 1.35rem; }
.metrics-heading p { color: var(--text-muted); font-size: 0.72rem; }
.chart-legend { display: flex; flex-wrap: wrap; gap: 10px 18px; margin: 8px 0 18px; color: var(--text-muted); font-size: 0.7rem; }
.chart-legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend-swatch { width: 9px; height: 9px; border-radius: 2px; }
.accuracy-swatch, .accuracy-bar { background: #526fca; }
.precision-swatch, .precision-bar { background: #36a28c; }
.recall-swatch, .recall-bar { background: #e5a64e; }
.f1-swatch, .f1-bar { background: #8d72c9; }
.chart-frame { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 8px; min-width: 0; }
.chart-y-axis {
  height: 220px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: var(--text-faint);
  font-size: 9px;
  text-align: right;
  transform: translateY(-4px);
}
.chart-content { min-width: 0; overflow-x: auto; padding-bottom: 5px; }
.chart-plot { position: relative; height: 220px; min-width: 470px; margin-bottom: 34px; border-bottom: 1px solid var(--stroke-strong); }
.chart-gridline { position: absolute; right: 0; left: 0; border-top: 1px solid #edf0f5; pointer-events: none; }
.chart-model-groups { position: absolute; inset: 0; display: flex; justify-content: space-around; }
.chart-model-group { position: relative; width: 31%; height: 100%; display: flex; justify-content: center; }
.chart-bars { width: min(100%, 150px); height: 100%; display: flex; align-items: stretch; justify-content: center; gap: 5px; }
.chart-bar-column { width: 22%; height: 100%; display: flex; align-items: flex-end; }
.chart-bar { width: 100%; min-height: 1px; border-radius: 6px 6px 0 0; cursor: help; transition: filter 140ms ease, opacity 140ms ease; }
.chart-bar:hover { filter: brightness(0.88); opacity: 0.9; }
.chart-model-label {
  position: absolute;
  top: calc(100% + 10px);
  left: 50%;
  width: 100%;
  color: var(--text-muted);
  font-size: 0.68rem;
  line-height: 1.3;
  text-align: center;
  transform: translateX(-50%);
}
.metrics-status,
.metrics-error { margin: 0; padding: 12px; border-radius: 8px; background: #f7f9fc; color: #718098; font-size: 0.75rem; }
.metrics-error { border: 1px solid rgba(191, 79, 72, 0.08); background: rgba(191, 79, 72, 0.04); color: #bf4f48; }
.confusion-section { margin-top: 28px; padding-top: 22px; border-top: 1px solid #edf0f5; }
.confusion-heading { margin-bottom: 14px; }
.confusion-heading h3 { margin: 0; color: var(--text); font-size: 1rem; }
.confusion-heading p { margin-top: 6px; color: var(--text-muted); font-size: 0.72rem; }
.breakdown-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 14px; }
.breakdown-card { min-width: 0; padding: 15px; border: 1px solid #e8edf4; border-radius: 12px; background: linear-gradient(150deg, #ffffff 0%, #f9fbfe 100%); box-shadow: 0 4px 12px rgba(29, 48, 83, 0.035); }
.breakdown-card h4 { margin: 0 0 16px; color: var(--text); font-size: 0.82rem; }
.breakdown-summary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.summary-stat { display: flex; flex-direction: column; gap: 5px; }
.summary-stat span, .breakdown-totals span { color: #758198; font-size: 0.66rem; }
.summary-stat strong { font-size: 1.25rem; font-variant-numeric: tabular-nums; }
.correct-stat strong { color: #34815d; }
.incorrect-stat strong { color: #b35f55; }
.prediction-bar { display: flex; width: 100%; height: 10px; overflow: hidden; margin-top: 16px; border-radius: 999px; background: #edf1f6; }
.prediction-bar-correct { background: #55a77d; transition: width 250ms ease; }
.prediction-bar-incorrect { background: #dc877b; transition: width 250ms ease; }
.prediction-bar-legend { display: flex; gap: 16px; margin-top: 8px; color: #8490a2; font-size: 0.62rem; }
.prediction-bar-legend span { display: inline-flex; align-items: center; gap: 5px; }
.prediction-bar-legend i { width: 7px; height: 7px; border-radius: 50%; }
.bar-legend-correct { background: #55a77d; }
.bar-legend-incorrect { background: #dc877b; }
.breakdown-totals { display: flex; align-items: center; justify-content: space-between; margin-top: 12px; padding-top: 12px; border-top: 1px solid #e9edf3; }
.breakdown-totals strong { color: var(--text); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
.details-button {
  margin-top: 12px;
  border: 1px solid var(--stroke-strong);
  background: rgba(255,255,255,0.7);
  color: var(--primary);
  cursor: pointer;
}
.details-button:hover { border-color: #bdc9e8; background: #f7f9ff; }
.breakdown-details { display: grid; gap: 12px; margin-top: 14px; padding-top: 13px; border-top: 1px solid #e9edf3; }
.detail-group h5 { margin: 0 0 8px; color: #52617a; font-size: 0.7rem; }
.detail-group p { display: flex; justify-content: space-between; gap: 8px; margin: 5px 0 0; color: #758198; font-size: 0.64rem; }
.detail-group p strong { color: var(--text); font-size: 0.66rem; font-variant-numeric: tabular-nums; }

@media (max-width: 900px) {
  .app-container { padding: 0 20px; }
  .stats-grid,
  .feature-grid,
  .metric-grid,
  .info-grid,
  .summary-grid,
  .pipeline-row { grid-template-columns: 1fr 1fr; }
  .page-footer { flex-direction: column; align-items: flex-start; }
}

@media (max-width: 640px) {
  .page-shell { padding: 12px; }
  .app-container { min-height: calc(100vh - 24px); padding: 0 16px; border-radius: 18px; }
  .topbar { min-height: 74px; flex-wrap: wrap; padding: 14px 0; }
  .navbar { width: 100%; justify-content: space-between; }
  .nav-link { padding: 8px 10px; font-size: 0.72rem; }
  .hero-section { margin-top: 18px; }
  .hero-actions,
  .card-footer,
  .action-buttons { flex-direction: column; align-items: stretch; }
  .stats-grid,
  .feature-grid,
  .metric-grid,
  .info-grid,
  .summary-grid,
  .pipeline-row,
  .confusion-box { grid-template-columns: 1fr; }
  .bar-row { grid-template-columns: 78px 1fr 42px; }
  .page-section { padding-bottom: 20px; }
  .analysis-card,
  .metric-card,
  .performance-card,
  .summary-card,
  .feature-card,
  .pipeline-step,
  .why-block { padding-left: 16px; padding-right: 16px; }
  .app-container,
  .page-body { width: 100%; }
  .primary-button,
  .secondary-button,
  .analyze-button,
  .clear-button,
  .details-button { width: 100%; }
  .result-header { flex-direction: column; align-items: flex-start; }
  .confidence-value { margin-left: 0; }
  .metrics-heading { flex-direction: column; align-items: flex-start; }
  .action-buttons { width: 100%; }
  .action-buttons button { flex: 1; }
  .result-card { padding: 19px; }
  .metrics-section { padding: 17px 14px; }
  .input-badge { display: none; }
  .page-footer { flex-direction: column; align-items: center; gap: 5px; }
}